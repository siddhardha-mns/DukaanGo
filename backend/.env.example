# Copy this file to backend/.env and add your Sarvam API subscription key.
SARVAM_API_KEY=
# Optional: override only for a Sarvam-compatible staging or test service.
SARVAM_API_BASE_URL=https://api.sarvam.ai
# Supported model for /v1/chat/completions. Do not use retired sarvam-m.
SARVAM_CHAT_MODEL=sarvam-105b
# Current voice models for transcription and speech synthesis.
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
# Mayura is the dedicated Indic-language translation model.
SARVAM_TRANSLATION_MODEL=mayura:v1
# Timeout for upstream Sarvam requests, in seconds.
SARVAM_TIMEOUT_SECONDS=30
